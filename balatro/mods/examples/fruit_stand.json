{
  "format": 1,
  "id": "fruit_stand",
  "name": "Fruit Stand",
  "version": "1.0.0",
  "author": "BalatroEngine",
  "description": "Six fresh jokers with their own art. An example of what a mod's jokers can do: score on cards, draw chances, keep values that grow, retrigger cards, pay at cash out, change the run while they are there and make new cards.",
  "tags": [
    "jokers",
    "example"
  ],
  "loc": {
    "ru": {
      "name": "Фруктовая лавка",
      "description": "Шесть свежих джокеров со своими рисунками. Пример того, что умеют джокеры модов: очки за карты, шансы, растущие значения, повторы карт, деньги при выплате, изменения забега и новые карты."
    }
  },
  "jokers": [
    {
      "key": "cherry_seven",
      "name": "Cherry Seven",
      "rarity": 1,
      "cost": 5,
      "sprite": "cherry_seven",
      "config": {
        "mult": 7,
        "odds": 7,
        "money": 7
      },
      "text": [
        "Each played {C:attention}7{} gives",
        "{C:mult}+#1#{} Mult when scored,",
        "{C:green}#2# in #3#{} chance to",
        "also earn {C:money}$#4#{}"
      ],
      "vars": [
        "self.mult",
        "game.probability",
        "self.odds",
        "self.money"
      ],
      "loc": {
        "ru": {
          "name": "Вишнёвая семёрка",
          "text": [
            "Каждая сыгранная {C:attention}7{}",
            "даёт {C:mult}+#1#{} к множителю,",
            "шанс {C:green}#2# из #3#{}",
            "получить ещё {C:money}$#4#{}"
          ]
        }
      },
      "effects": [
        {
          "on": "card_scored",
          "if": "card.rank == 7",
          "do": [
            {
              "mult": "self.mult"
            }
          ]
        },
        {
          "on": "card_scored",
          "if": "card.rank == 7 and chance(1, self.odds)",
          "do": [
            {
              "dollars": "self.money"
            }
          ]
        }
      ]
    },
    {
      "key": "banana_bunch",
      "name": "Banana Bunch",
      "rarity": 2,
      "cost": 6,
      "sprite": "banana_bunch",
      "config": {
        "xmult": 3,
        "odds": 6
      },
      "eternal_compat": false,
      "text": [
        "{X:mult,C:white} X#1# {} Mult",
        "{C:green}#2# in #3#{} chance this",
        "card is eaten at",
        "the end of the round"
      ],
      "vars": [
        "self.xmult",
        "game.probability",
        "self.odds"
      ],
      "loc": {
        "ru": {
          "name": "Связка бананов",
          "text": [
            "{X:mult,C:white} X#1# {} множитель",
            "Шанс {C:green}#2# из #3#{}, что",
            "карту съедят",
            "в конце раунда"
          ]
        }
      },
      "effects": [
        {
          "on": "score",
          "do": [
            {
              "xmult": "self.xmult"
            }
          ]
        },
        {
          "on": "round_end",
          "if": "chance(1, self.odds)",
          "do": [
            {
              "destroy_self": true
            },
            {
              "message": "k_eaten_ex"
            }
          ],
          "else": [
            {
              "message": "k_safe_ex"
            }
          ]
        }
      ]
    },
    {
      "key": "orchard",
      "name": "Orchard",
      "rarity": 1,
      "cost": 5,
      "sprite": "orchard",
      "config": {
        "chips": 0,
        "gain": 4
      },
      "text": [
        "This Joker gains {C:chips}+#2#{} Chips",
        "for each {C:hearts}Heart{} discarded",
        "{C:inactive}(Currently {C:chips}+#1#{C:inactive} Chips)"
      ],
      "vars": [
        "self.chips",
        "self.gain"
      ],
      "loc": {
        "ru": {
          "name": "Сад",
          "text": [
            "Джокер получает {C:chips}+#2#{} фишек",
            "за каждую сброшенную {C:hearts}черву{}",
            "{C:inactive}(сейчас {C:chips}+#1#{C:inactive} фишек)"
          ]
        }
      },
      "effects": [
        {
          "on": "discard",
          "if": "is_suit(card, 'Hearts') and not card.debuffed",
          "do": [
            {
              "set": {
                "chips": "self.chips + self.gain"
              }
            },
            {
              "message": "k_upgrade_ex"
            }
          ]
        },
        {
          "on": "score",
          "if": "self.chips > 0",
          "do": [
            {
              "chips": "self.chips"
            }
          ]
        }
      ]
    },
    {
      "key": "fruit_salad",
      "name": "Fruit Salad",
      "rarity": 3,
      "cost": 8,
      "sprite": "fruit_salad",
      "config": {
        "times": 1
      },
      "text": [
        "Retrigger every scored card",
        "if the scored cards have",
        "{C:attention}all four suits{}"
      ],
      "loc": {
        "ru": {
          "name": "Фруктовый салат",
          "text": [
            "Повтор каждой засчитанной",
            "карты, если среди них",
            "есть {C:attention}все четыре масти{}"
          ]
        }
      },
      "effects": [
        {
          "on": "retrigger_scored",
          "if": "count_suit(scoring, 'Hearts') > 0 and count_suit(scoring, 'Spades') > 0 and count_suit(scoring, 'Clubs') > 0 and count_suit(scoring, 'Diamonds') > 0",
          "do": [
            {
              "retrigger": "self.times"
            }
          ]
        }
      ]
    },
    {
      "key": "market_stall",
      "name": "Market Stall",
      "rarity": 2,
      "cost": 6,
      "sprite": "market_stall",
      "config": {
        "per": 2
      },
      "passive": {
        "consumable_slots": 1
      },
      "text": [
        "{C:attention}+1{} consumable slot.",
        "Earn {C:money}$#1#{} per consumable",
        "held at the end of the round"
      ],
      "vars": [
        "self.per"
      ],
      "loc": {
        "ru": {
          "name": "Прилавок",
          "text": [
            "{C:attention}+1{} ячейка расходников.",
            "{C:money}$#1#{} за каждый расходник",
            "в конце раунда"
          ]
        }
      },
      "effects": [
        {
          "on": "cash_out",
          "if": "game.consumable_count > 0",
          "do": [
            {
              "dollars": "self.per * game.consumable_count"
            }
          ]
        }
      ]
    },
    {
      "key": "seed_packet",
      "name": "Seed Packet",
      "rarity": 2,
      "cost": 6,
      "sprite": "seed_packet",
      "config": {
        "rounds": 0,
        "every": 3
      },
      "text": [
        "Every {C:attention}#2#{} blinds selected,",
        "create a {C:planet}Planet{} card",
        "{C:inactive}(#1#/#2#, needs room)"
      ],
      "vars": [
        "self.rounds",
        "self.every"
      ],
      "loc": {
        "ru": {
          "name": "Пакет семян",
          "text": [
            "Каждый {C:attention}#2#-й{} выбранный блайнд",
            "создаёт карту {C:planet}планеты{}",
            "{C:inactive}(#1#/#2#, если есть место)"
          ]
        }
      },
      "effects": [
        {
          "on": "blind_selected",
          "if": "self.rounds + 1 >= self.every",
          "do": [
            {
              "set": {
                "rounds": 0
              }
            },
            {
              "create": {
                "set": "Planet"
              }
            },
            {
              "message": "k_plus_planet"
            }
          ],
          "else": [
            {
              "set": {
                "rounds": "self.rounds + 1"
              }
            }
          ]
        }
      ]
    }
  ],
  "assets": {
    "cherry_seven": "data:image/png;base64,",
    "banana_bunch": "data:image/png;base64,",
    "orchard": "data:image/png;base64,",
    "fruit_salad": "data:image/png;base64,",
    "market_stall": "data:image/png;base64,",
    "seed_packet": "data:image/png;base64,"
  }
}
